# Database (local Postgres for dev, Neon in production)
DATABASE_URL=postgresql://apple@localhost:5432/northville_dev
DIRECT_URL=postgresql://apple@localhost:5432/northville_dev

# Admin
ADMIN_SESSION_JWT_SECRET=change-me-to-a-long-random-string
SUPERADMIN_EMAIL=admin@northvilleconsultinggroup.com
SUPERADMIN_INITIAL_PASSWORD=change-me

# URLs (admin calls WEB_URL to refresh the public site after a publish)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
REVALIDATE_SECRET=change-me

# Email (Resend). Without a key, enquiries are saved and the email is logged to the console.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Northville Website <onboarding@resend.dev>

# Uploads. Without a token, files are saved to apps/web/public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=
SITE_URL=http://localhost:3000
PROD_DIRECT_URL=
